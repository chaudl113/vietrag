# ============================================
# VietRAG - Biến môi trường
# ============================================
# Sao chép file này thành .env và chỉnh sửa:
#   cp .env.example .env
# ============================================

# ---- OpenAI (BẮT BUỘC) ----
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=vietrag_password
MYSQL_DATABASE=vietrag
MYSQL_PORT=3306

# ---- Elasticsearch ----
ES_HOST=localhost
ES_PORT=9200

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO (Object Storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=vietrag_admin
MINIO_SECRET_KEY=vietrag_secret_key
MINIO_BUCKET=vietrag-docs
MINIO_USE_SSL=false

# ---- Backend ----
BACKEND_PORT=3001
JWT_SECRET=change_me_to_random_string_in_production
CORS_ORIGIN=http://localhost:3000

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ---- App ----
APP_NAME=VietRAG
NODE_ENV=development
LOG_LEVEL=info
