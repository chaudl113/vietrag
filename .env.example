# ============================================
# VietRAG - Biến môi trường cho docker compose
# ============================================
# File này chỉ phục vụ `docker compose` (đọc .env ở thư mục gốc repo):
#   cp .env.example .env
# Chạy backend trực tiếp (npm run dev) thì dùng backend/.env.example.
# ============================================

# ---- OpenAI (BẮT BUỘC) ----
OPENAI_API_KEY=sk-your-api-key-here

# ---- Backend ----
# BẮT BUỘC, không có giá trị mặc định. Tạo bằng: openssl rand -hex 32
JWT_SECRET=
# Port publish ra máy host (trong container backend luôn nghe 3001)
BACKEND_PORT=3001

# ---- Frontend ----
FRONTEND_PORT=3000
